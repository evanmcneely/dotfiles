{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "single": false,
    "tree": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "terminal": false,
    "grouping": "auto",
    "image_preview": true,
    "tps": true,
    "markdown": "rendered",
    "permissions": "autoaccept"
  },
  "animations": true,
  "plugins": [
    // "opencode-vim@latest"
  ],
  "tabs": {
    "layout": "vertical",
    "indicators": "status"
  }
}
